{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradewithme-global",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tradewithme-global-db",
      "database_id": "RETAIN_YOUR_EXISTING_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
